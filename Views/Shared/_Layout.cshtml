@inject Calorix.Patterns.Facade.ICalorixFacade _facade
@{
  var userId = Context.Session.GetString("UserId");
  var userRole = Context.Session.GetString("UserRole");
  var userName = Context.Session.GetString("UserName") ?? "Usuario";
  var isLogged = userId != null;
  var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
  bool isUsuario = userRole == "Usuario";
  bool isNutriologo = userRole == "Nutriologo";
  string userInitial = !string.IsNullOrEmpty(userName) ? userName[0].ToString().ToUpper() : "U";

  bool esAdminLogged = false;
  int observacionesNoLeidas = 0;
  if (isLogged && int.TryParse(userId, out int loggedId))
  {
    if (isNutriologo) esAdminLogged = _facade.EsAdmin(loggedId);
    if (isUsuario) observacionesNoLeidas = _facade.ObtenerObservacionesPaciente(loggedId).Count(o => !o.Leida);
  }
}
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@(ViewData["Title"] != null ? ViewData["Title"] + " · " : "")Calorix</title>
  <link rel="stylesheet" href="~/css/site.css" />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><text y='20' font-size='22'>🌿</text></svg>" />
</head>
<body>
@if (!isLogged || ctrl == "Home")
{
  @RenderBody()
}
else
{
<div class="app-shell">
  <aside class="sidebar">
    <div class="sidebar-brand">
      <div class="logo-mark">🌿 Calorix</div>
      <div class="logo-sub">@(isNutriologo ? "Panel Profesional" : "Nutrición Inteligente")</div>
    </div>

    <nav class="sidebar-nav">
      @if (isUsuario)
      {
        <div class="nav-section-label">Personal</div>
        <a href="/Seguimiento" class="nav-item @(ctrl=="Seguimiento"?"active":"")">
          <span class="icon">📊</span> Dashboard
        </a>
        <a href="/Alimentos" class="nav-item @(ctrl=="Alimentos"?"active":"")">
          <span class="icon">🥗</span> Alimentos
        </a>
        <a href="/Registro" class="nav-item @(ctrl=="Registro"?"active":"")">
          <span class="icon">📝</span> Registro de Comidas
        </a>
        <a href="/MisPlanes" class="nav-item @(ctrl=="MisPlanes"?"active":"")">
          <span class="icon">📋</span> Mis Planes
          @if (observacionesNoLeidas > 0)
          {
            <span class="badge badge-green" style="margin-left:auto;font-size:10px">@observacionesNoLeidas</span>
          }
        </a>
        <a href="/Perfil" class="nav-item @(ctrl=="Perfil"?"active":"")">
          <span class="icon">👤</span> Mi Perfil
        </a>
      }
      @if (isNutriologo)
      {
        <div class="nav-section-label">Nutriólogo</div>
        <a href="/Pacientes" class="nav-item @(ctrl=="Pacientes"?"active":"")">
          <span class="icon">👥</span> Mis Pacientes
        </a>
        <a href="/Planes" class="nav-item @(ctrl=="Planes"?"active":"")">
          <span class="icon">📋</span> Planes Alimenticios
        </a>
        <a href="/Nutriologo" class="nav-item @(ctrl=="Nutriologo"?"active":"")">
          <span class="icon">🩺</span> Perfil Profesional
        </a>
        @if (esAdminLogged)
        {
          <div class="nav-section-label">Administración</div>
          <a href="/Admin" class="nav-item @(ctrl=="Admin"?"active":"")">
            <span class="icon">🛡️</span> Validar Nutriólogos
          </a>
        }
      }
    </nav>

    <div class="user-card">
      <div class="user-avatar">@userInitial</div>
      <div class="user-name">@userName</div>
      <div class="user-role-lbl">@(isNutriologo ? "Nutriólogo" : "Usuario")</div>
    </div>
    <a href="/Home/Logout" class="logout-btn">↩ Cerrar sesión</a>
  </aside>

  <main class="main-content">
    <header class="topbar">
      <button type="button" class="mobile-menu-btn" onclick="document.querySelector('.sidebar').classList.toggle('mobile-open')" aria-label="Menú">☰</button>
      <div class="page-title-bar">@(ViewData["Title"] ?? "Calorix")</div>
      <div class="topbar-user">
        <div class="topbar-avatar">@userInitial</div>
        <span>@userName</span>
      </div>
    </header>
    <div class="sidebar-backdrop" onclick="document.querySelector('.sidebar').classList.remove('mobile-open')"></div>
    <div class="content">
      @if (TempData["Msg"] != null)
      {
        <div class="alert alert-success">✓ @TempData["Msg"]</div>
      }
      @RenderBody()
    </div>
  </main>
</div>
}

<div id="app-toast" class="notif"><div class="notif-dot"></div><span id="app-toast-msg"></span></div>

<script src="~/js/site.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
