<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@(ViewData["Title"] != null ? ViewData["Title"] + " · " : "")Calorix</title>
  <link rel="stylesheet" href="~/css/site.css" />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%232563EB'><path d='M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5'/></svg>" />
</head>
<body>
@{
  var userId = Context.Session.GetString("UserId");
  var userRole = Context.Session.GetString("UserRole");
  var userName = Context.Session.GetString("UserName") ?? "Usuario";
  var isLogged = userId != null;
  var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
  bool isUsuario = userRole == "Usuario";
  bool isNutriologo = userRole == "Nutriologo";
}

@if (!isLogged || ctrl == "Home")
{
  @RenderBody()
}
else
{
<div class="app-shell">
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-brand">
      <div class="sidebar-logo">
        <div class="sidebar-logo-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M11 2v20c-5.07-.5-9-4.79-9-10s3.93-9.5 9-10zm2.03 0v8.99H22c-.47-4.74-4.24-8.52-8.97-8.99zm0 11.01V22c4.74-.47 8.5-4.25 8.97-8.99h-8.97z"/>
          </svg>
        </div>
        <span class="sidebar-logo-text">Calo<span>rix</span></span>
      </div>
    </div>

    <nav class="sidebar-nav">
      @if (isUsuario)
      {
        <div class="sidebar-section-label">Principal</div>
        <a href="/Seguimiento" class="nav-item @(ctrl=="Seguimiento"?"active":"")">
          <span class="nav-item-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 12l4-4 4 4 6-6"/></svg>
          </span> Seguimiento
        </a>
        <a href="/Registro" class="nav-item @(ctrl=="Registro"?"active":"")">
          <span class="nav-item-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 1 1 3 3L7 19l-4 1 1-4 12.5-12.5z"/></svg>
          </span> Registro de Comidas
        </a>
        <div class="sidebar-section-label" style="margin-top:.75rem">Explorar</div>
        <a href="/Alimentos" class="nav-item @(ctrl=="Alimentos"?"active":"")">
          <span class="nav-item-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12h20"/><path d="M5 12V8a3 3 0 0 1 3-3h8a3 3 0 0 1 3 3v4"/><path d="M5 12v6a3 3 0 0 0 3 3h8a3 3 0 0 0 3-3v-6"/></svg>
          </span> Alimentos y Recetas
        </a>
        <a href="/Perfil" class="nav-item @(ctrl=="Perfil"?"active":"")">
          <span class="nav-item-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </span> Mi Perfil
        </a>
      }
      @if (isNutriologo)
      {
        <div class="sidebar-section-label">Gestión</div>
        <a href="/Pacientes" class="nav-item @(ctrl=="Pacientes"?"active":"")">
          <span class="nav-item-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </span> Mis Pacientes
        </a>
        <a href="/Planes" class="nav-item @(ctrl=="Planes"?"active":"")">
          <span class="nav-item-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="17" x2="15" y2="17"/></svg>
          </span> Planes Alimenticios
        </a>
        <div class="sidebar-section-label" style="margin-top:.75rem">Cuenta</div>
        <a href="/Nutriologo" class="nav-item @(ctrl=="Nutriologo"?"active":"")">
          <span class="nav-item-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.29 1.51 4.04 3 5.5l7 7Z"/></svg>
          </span> Mi Perfil Profesional
        </a>
      }
    </nav>

    <div class="sidebar-footer">
      <div class="sidebar-user">
        <div class="sidebar-avatar">@(userName.Length > 0 ? userName[0].ToString().ToUpper() : "U")</div>
        <div class="sidebar-user-info">
          <div class="sidebar-user-name">@userName</div>
          <div class="sidebar-user-role">@(isNutriologo ? "Nutriólogo" : "Usuario")</div>
        </div>
      </div>
      <a href="/Home/Logout" class="nav-item" style="color:#FCA5A5">
        <span class="nav-item-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </span> Cerrar sesión
      </a>
    </div>
  </aside>

  <main class="main-content">
    @if (TempData["Msg"] != null)
    {
      <div style="padding: var(--space-4) var(--space-8) 0;">
        <div class="alert alert-success">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <span>@TempData["Msg"]</span>
        </div>
      </div>
    }
    @RenderBody()
  </main>
</div>
}

<script src="~/js/site.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
