@using Calorix.Models
@using System.Text.Json
@{
    ViewData["Title"] = "Registro de Comidas";
    var resumen = (dynamic)ViewBag.Resumen;
    var alimentos = (List<Alimento>)ViewBag.Alimentos;
    var recetas = (List<Receta>)ViewBag.Recetas;

    float totalCal = resumen.TotalCalorias;
    float meta = resumen.MetaCalorica;
    var registros = (List<RegistroComida>)resumen.Registros;

    var alimentosJson = JsonSerializer.Serialize(alimentos.Select(a => new {
        id = a.Id, nombre = a.Nombre, categoria = a.Categoria,
        calorias = a.Calorias, proteinas = a.Proteinas, carbohidratos = a.Carbohidratos, grasas = a.Grasas
    }));
    var recetasJson = JsonSerializer.Serialize(recetas.Select(r => new {
        id = r.Id, nombre = r.Nombre,
        caloriasTotal = r.CaloriasTotal, proteinasTotal = r.ProteinasTotal,
        carbosTotal = r.CarbosTotal, grasasTotal = r.GrasasTotal
    }));
}

<div class="page-header">
  <div>
    <div class="page-title">Registro de Comidas</div>
    <div class="page-subtitle">@DateTime.Today.ToString("dddd, d 'de' MMMM", new System.Globalization.CultureInfo("es-MX"))</div>
  </div>
</div>

<div class="grid-2">
  <!-- ── FORMULARIO REGISTRO ── -->
  <div class="card">
    <div style="font-family:var(--font-head);font-size:15px;font-weight:700;margin-bottom:18px">Registrar Comida</div>

    <div class="form-group">
      <label class="form-label">Momento del día</label>
      <div class="tabs" id="momento-tabs" style="margin-bottom:0">
        <button type="button" class="tab active" data-momento="Desayuno" onclick="setMomento('Desayuno', this)">☀️ Desayuno</button>
        <button type="button" class="tab" data-momento="Comida" onclick="setMomento('Comida', this)">🌤️ Comida</button>
        <button type="button" class="tab" data-momento="Cena" onclick="setMomento('Cena', this)">🌙 Cena</button>
        <button type="button" class="tab" data-momento="Snack" onclick="setMomento('Snack', this)">🍎 Snack</button>
      </div>
    </div>

    <div class="form-group">
      <label class="form-label">Busca un alimento o receta</label>
      <div class="fsr-wrap">
        <div class="search-wrap">
          <i class="s-icon">🔍</i>
          <input type="text" class="form-control" id="reg-search"
                 placeholder="Toca para ver todos o escribe para buscar…"
                 autocomplete="off"
                 oninput="buscarParaRegistro(this.value)"
                 onfocus="buscarParaRegistro(this.value)" />
        </div>
        <div class="fsr-dropdown" id="fsr-dropdown"></div>
      </div>
      <div class="sel-chip" id="sel-chip" style="display:none">
        <span class="chip-emoji" id="chip-emoji">🍽️</span>
        <div class="chip-info">
          <div class="chip-name" id="chip-name">—</div>
          <div class="chip-sub" id="chip-sub">—</div>
        </div>
        <button type="button" class="chip-clear" onclick="clearSel()">✕</button>
      </div>
    </div>

    <div class="form-group">
      <label class="form-label">Cantidad (<span id="qty-unit">gramos</span>)</label>
      <input type="number" class="form-control" id="inp-cantidad" value="100" min="1" max="2000" oninput="previewMacros()" />
    </div>

    <div id="prev-box" style="display:none;background:var(--bg3);border-radius:8px;padding:12px;margin-bottom:14px">
      <div style="font-size:10px;letter-spacing:.07em;text-transform:uppercase;color:var(--text3);margin-bottom:8px">Vista previa</div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;font-size:13px">
        <span>🔥 <strong id="pv-cal">—</strong> kcal</span>
        <span>💪 <strong id="pv-prot">—</strong>g prot</span>
        <span>🌾 <strong id="pv-carb">—</strong>g carbos</span>
        <span>🫒 <strong id="pv-gras">—</strong>g grasas</span>
      </div>
    </div>

    <button type="button" class="btn btn-primary btn-full" onclick="registrarComida()">✓ Registrar</button>
  </div>

  <!-- ── DIARIO DE HOY ── -->
  <div class="card">
    <div class="card-header">
      <div class="card-title">Diario de Hoy</div>
      <span class="badge badge-green">@((int)totalCal) kcal</span>
    </div>
    @if (!registros.Any())
    {
      <div class="empty">
        <div class="empty-icon">📋</div>
        <div class="empty-title">Sin registros hoy</div>
        <div>Agrega tu primera comida</div>
      </div>
    }
    else
    {
      @foreach (var r in registros.OrderByDescending(x => x.Id))
      {
        <div class="registro-item">
          <div class="momento-dot momento-@r.Momento"></div>
          <div style="flex:1">
            <div style="font-size:13px;font-weight:500">@r.NombreAlimento</div>
            <div style="font-size:11px;color:var(--text3)">@r.Momento · @r.Cantidad @r.UnidadCantidad · P:@((int)r.Proteinas)g</div>
          </div>
          <div style="font-family:var(--font-head);font-size:14px;font-weight:700;color:var(--green)">@((int)r.Calorias)</div>
          <button type="button" class="chip-clear" title="Eliminar" onclick="eliminarRegistro(@r.Id)">✕</button>
        </div>
      }
    }
  </div>
</div>

@section Scripts {
<script>
const _alimentos = @Html.Raw(alimentosJson);
const _recetas = @Html.Raw(recetasJson);
document.addEventListener('DOMContentLoaded', () => {
  initUnifiedSearch(_alimentos, _recetas);
});
</script>
}
