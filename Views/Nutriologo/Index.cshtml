@using Calorix.Models
@{
    ViewData["Title"] = "Perfil Profesional";
    bool yaRegistrado = ViewBag.YaRegistrado ?? false;
    var nutriologo = ViewBag.Nutriologo as Nutriologo;
    var documentos = ViewBag.Documentos as List<DocumentoNutriologo> ?? new();
    Layout = yaRegistrado ? "_Layout" : null;
}

@if (yaRegistrado && nutriologo != null)
{
  <div class="page-header">
    <div>
      <div class="page-title">Perfil Profesional</div>
      <div class="page-subtitle">Información y estado de validación de tu cuenta</div>
    </div>
  </div>

  <div class="grid-2" style="grid-template-columns:320px 1fr;align-items:start">
    <div class="card">
      <div style="text-align:center;padding-bottom:18px;border-bottom:1px solid var(--border);margin-bottom:18px">
        <div class="user-avatar" style="width:72px;height:72px;font-size:28px;margin:0 auto 14px">🩺</div>
        <div style="font-family:var(--font-head);font-size:18px;font-weight:700">@nutriologo.Nombre</div>
        <div class="text-sm text-muted mt-1">@nutriologo.Email</div>
        <div class="mt-3">
          @if (nutriologo.Validado)
          {
            <span class="badge badge-green">✓ Cuenta Validada</span>
          }
          else
          {
            <span class="badge badge-amber">⏳ Pendiente de Validación</span>
          }
        </div>
      </div>
      <div class="text-sm">
        <div class="flex justify-between mb-3"><span class="text-muted">Cédula</span><strong>@nutriologo.Cedula</strong></div>
        <div class="flex justify-between mb-3"><span class="text-muted">Especialidad</span><span>@nutriologo.Especialidad</span></div>
        <div class="flex justify-between"><span class="text-muted">Experiencia</span><span>@nutriologo.AniosExp años</span></div>
      </div>
    </div>

    <div class="card">
      <div style="font-family:var(--font-head);font-size:15px;font-weight:700;margin-bottom:6px">Estado de la Cuenta</div>
      <div class="text-sm text-muted mb-4">Documentación y validación profesional</div>

      @if (nutriologo.Validado)
      {
        <div class="alert alert-success">
          ✅ Tu cuenta ha sido validada. Puedes gestionar pacientes y crear planes alimenticios.
        </div>
      }
      else
      {
        <div class="alert alert-warning">
          ⏳ Tu cuenta está <strong>pendiente de validación</strong>. El equipo de Calorix revisará tu documentación.
        </div>
        <div style="background:var(--bg3);border-radius:8px;padding:14px;margin-top:14px">
          <div class="font-medium mb-2">Documentos requeridos</div>
          <div class="flex items-center gap-3 mb-2"><span style="color:var(--green)">✓</span><span class="text-sm">Cédula profesional (@nutriologo.Cedula)</span></div>
          <div class="flex items-center gap-3"><span style="color:var(--amber)">⏳</span><span class="text-sm">Título universitario — en revisión</span></div>
        </div>
      }

      <div class="mt-6">
        <div class="font-medium mb-3">Subir documentación adicional</div>
        @if (TempData["Err"] != null)
        {
          <div class="alert alert-warning text-sm" style="margin-bottom:10px">⚠ @TempData["Err"]</div>
        }
        <form method="post" action="/Nutriologo/SubirDocumento" enctype="multipart/form-data">
          <div class="form-group">
            <label class="form-label">Documento de validación (PDF, JPG, PNG · máx. 5 MB)</label>
            <input type="file" name="documento" class="form-control" accept=".pdf,.jpg,.jpeg,.png" required />
          </div>
          <button type="submit" class="btn btn-primary">Subir documento</button>
        </form>

        @if (documentos.Any())
        {
          <div class="mt-4">
            <div class="text-sm text-muted mb-2">Documentos subidos (@documentos.Count)</div>
            <div style="display:flex;flex-direction:column;gap:8px">
              @foreach (var d in documentos)
              {
                <div style="background:var(--bg3);border-radius:8px;padding:10px 12px;display:flex;justify-content:space-between;align-items:center;gap:12px">
                  <div style="min-width:0;flex:1">
                    <div class="text-sm" style="font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">📄 @d.NombreOriginal</div>
                    <div class="text-xs text-muted">@d.FechaSubida.ToString("dd/MM/yyyy HH:mm") · @(d.Tamano / 1024) KB</div>
                  </div>
                  @{
                    var badgeClass = d.Estado switch
                    {
                      "aprobado" => "badge-green",
                      "rechazado" => "badge-amber",
                      _ => "badge-amber"
                    };
                    var badgeTexto = d.Estado switch
                    {
                      "aprobado" => "✓ Aprobado",
                      "rechazado" => "✗ Rechazado",
                      _ => "⏳ Pendiente"
                    };
                  }
                  <span class="badge @badgeClass">@badgeTexto</span>
                </div>
              }
            </div>
          </div>
        }
      </div>
    </div>
  </div>
}
else
{
  <!-- Vista standalone de registro (sin sidebar) -->
  <!DOCTYPE html>
  <html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Calorix — Registro Nutriólogo</title>
    <link rel="stylesheet" href="~/css/site.css" />
  </head>
  <body>
  <div class="login-page">
    <div class="login-wrap" style="width:560px">
      <div class="login-logo">
        <div class="login-logo-mark">🌿 Calorix</div>
        <div class="login-logo-sub">Registro de Nutriólogo Profesional</div>
      </div>

      <div class="login-card">
        <h2>Crear cuenta de nutriólogo</h2>

        <form method="post" action="/Nutriologo/Registrar">
          <div class="form-row">
            <div class="form-group">
              <label class="form-label">Nombre completo *</label>
              <input type="text" name="nombre" class="form-control" placeholder="Dr. Juan Pérez" required />
            </div>
            <div class="form-group">
              <label class="form-label">Cédula Profesional *</label>
              <input type="text" name="cedula" class="form-control" placeholder="NUT-001234" required />
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label class="form-label">Email *</label>
              <input type="email" name="email" class="form-control" placeholder="nutriologo@email.com" required />
            </div>
            <div class="form-group">
              <label class="form-label">Contraseña *</label>
              <input type="password" name="password" class="form-control" placeholder="••••••••" required />
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label class="form-label">Especialidad *</label>
              <select name="especialidad" class="form-control" required>
                <option value="">Selecciona…</option>
                <option value="Nutrición Clínica">Nutrición Clínica</option>
                <option value="Nutrición Deportiva">Nutrición Deportiva</option>
                <option value="Nutrición Pediátrica">Nutrición Pediátrica</option>
                <option value="Nutrición Oncológica">Nutrición Oncológica</option>
                <option value="Nutrición General">Nutrición General</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">Años de experiencia</label>
              <input type="number" name="aniosExp" class="form-control" placeholder="5" min="0" max="60" value="1" />
            </div>
          </div>

          <div class="alert alert-info text-xs">
            ℹ️ Tu cuenta quedará pendiente de validación. Podrás gestionar pacientes mientras tanto.
          </div>

          <button type="submit" class="btn btn-primary btn-full btn-lg mt-4">Crear cuenta de nutriólogo →</button>
        </form>

        <div class="login-footer">
          ¿Ya tienes cuenta? <a href="/Home/Login" style="color:var(--green);font-weight:600">Inicia sesión</a>
        </div>
      </div>
    </div>
  </div>
  <script src="~/js/site.js"></script>
  </body>
  </html>
}
