@{
    Layout = null;
    ViewData["Title"] = "Iniciar sesión";
}
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Calorix — Iniciar sesión</title>
  <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
<div class="login-page">
  <div class="login-card">
    <div class="login-brand">
      <div class="login-logo">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M11 2v20c-5.07-.5-9-4.79-9-10s3.93-9.5 9-10zm2.03 0v8.99H22c-.47-4.74-4.24-8.52-8.97-8.99zm0 11.01V22c4.74-.47 8.5-4.25 8.97-8.99h-8.97z"/>
        </svg>
      </div>
      <div class="login-title">Calorix</div>
      <div class="login-subtitle">Tu asistente de nutrición inteligente</div>
    </div>

    @if (ViewBag.Error != null)
    {
      <div class="alert alert-error mb-4">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <span>@ViewBag.Error</span>
      </div>
    }

    <div class="role-selector" id="role-selector">
      <div class="role-card selected" id="role-usuario" onclick="selectRole('Usuario')">
        <div class="role-card-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
          </svg>
        </div>
        <div class="role-card-name">Usuario</div>
        <div class="role-card-desc">Sigue tu nutrición personal</div>
      </div>
      <div class="role-card" id="role-nutriologo" onclick="selectRole('Nutriologo')">
        <div class="role-card-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.29 1.51 4.04 3 5.5l7 7Z"/>
          </svg>
        </div>
        <div class="role-card-name">Nutriólogo</div>
        <div class="role-card-desc">Gestiona pacientes y planes</div>
      </div>
    </div>

    <form method="post" action="/Home/Login" id="login-form">
      <div class="form-group">
        <label class="form-label" for="email">Correo electrónico</label>
        <div class="input-group">
          <span class="input-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </span>
          <input type="email" id="email" name="email" class="form-control"
                 placeholder="maria@demo.com" value="maria@demo.com" required />
        </div>
      </div>
      <div class="form-group">
        <label class="form-label" for="password">Contraseña</label>
        <div class="input-group">
          <span class="input-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          </span>
          <input type="password" id="password" name="password" class="form-control"
                 placeholder="••••••••" value="demo123" required />
        </div>
      </div>
      <button type="submit" class="btn btn-primary btn-full btn-lg">
        Iniciar sesión
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </button>
    </form>

    <div class="demo-hints">
      <strong style="color:var(--color-foreground)">Accesos demo</strong> · contraseña: <code>demo123</code>
      <div style="margin-top:.5rem"><span style="color:var(--color-muted-foreground)">Usuarios:</span></div>
      <button type="button" class="demo-btn" onclick="fillDemo('maria@demo.com','demo123','Usuario')">María García</button>
      <button type="button" class="demo-btn" onclick="fillDemo('juan@demo.com','demo123','Usuario')">Juan López</button>
      <button type="button" class="demo-btn" onclick="fillDemo('ana@demo.com','demo123','Usuario')">Ana Martínez</button>
      <div style="margin-top:.5rem"><span style="color:var(--color-muted-foreground)">Nutriólogos:</span></div>
      <button type="button" class="demo-btn" onclick="fillDemo('carlos@demo.com','demo123','Nutriologo')">Dr. Carlos</button>
      <button type="button" class="demo-btn" onclick="fillDemo('laura@demo.com','demo123','Nutriologo')">Dra. Laura</button>
    </div>

    <p style="text-align:center;margin-top:1.5rem;font-size:var(--font-size-xs);color:var(--color-muted-foreground)">
      ¿Eres nutriólogo y no tienes cuenta?
      <a href="/Nutriologo" style="color:var(--color-primary);font-weight:600">Regístrate aquí</a>
    </p>
  </div>
</div>

<script src="~/js/site.js"></script>
<script>
let _selectedRole = 'Usuario';
function selectRole(role) {
  _selectedRole = role;
  document.getElementById('role-usuario').classList.toggle('selected', role === 'Usuario');
  document.getElementById('role-nutriologo').classList.toggle('selected', role === 'Nutriologo');
  document.getElementById('email').placeholder = role === 'Usuario' ? 'maria@demo.com' : 'carlos@demo.com';
}
function fillDemo(email, pass, role) {
  selectRole(role);
  document.getElementById('email').value = email;
  document.getElementById('password').value = pass;
}
</script>
</body>
</html>
