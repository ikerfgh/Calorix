@{
    Layout = null;
    ViewData["Title"] = "Iniciar sesión";
}
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Calorix — Iniciar sesión</title>
  <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
<div class="login-page">
  <div class="login-wrap">
    <div class="login-logo">
      <div class="login-logo-mark">🌿 Calorix</div>
      <div class="login-logo-sub">Tu asistente de nutrición inteligente</div>
    </div>

    <div class="login-role-row">
      <div class="role-btn selected" id="role-usuario" onclick="selectRole('Usuario')">
        <div class="role-icon">👤</div>
        <div class="role-label">Usuario</div>
        <div class="role-desc">Registra comidas y monitorea tu progreso</div>
      </div>
      <div class="role-btn" id="role-nutriologo" onclick="selectRole('Nutriologo')">
        <div class="role-icon">🩺</div>
        <div class="role-label">Nutriólogo</div>
        <div class="role-desc">Gestiona pacientes y planes alimenticios</div>
      </div>
    </div>

    <div class="login-card">
      <h2 id="loginTitle">Iniciar sesión como Usuario</h2>

      @if (ViewBag.Error != null)
      {
        <div class="alert alert-error">@ViewBag.Error</div>
      }

      <form method="post" action="/Home/Login">
        <div class="form-group">
          <label class="form-label" for="email">Correo electrónico</label>
          <input class="form-control" id="email" name="email" type="email" placeholder="maria@demo.com" value="maria@demo.com" required />
        </div>
        <div class="form-group" style="margin-bottom:20px">
          <label class="form-label" for="password">Contraseña</label>
          <input class="form-control" id="password" name="password" type="password" value="demo123" required />
        </div>
        <button class="btn btn-primary btn-full btn-lg" type="submit">Entrar a Calorix</button>
      </form>

      <div class="login-footer">
        ¿No tienes cuenta? <a href="/Cuenta" style="color:var(--green);font-weight:600">Regístrate como usuario</a>
        <span style="color:var(--text3)"> · </span>
        <a href="/Nutriologo" style="color:var(--green);font-weight:600">Regístrate como nutriólogo</a>
      </div>
    </div>

    <div class="quick-logins">
      <div class="quick-label">Accesos rápidos (demo · contraseña: demo123)</div>
      <button type="button" class="btn btn-ghost btn-full text-sm" onclick="fillDemo('maria@demo.com','Usuario')">👤 María García (Usuario)</button>
      <button type="button" class="btn btn-ghost btn-full text-sm" onclick="fillDemo('juan@demo.com','Usuario')">👤 Juan López (Usuario)</button>
      <button type="button" class="btn btn-ghost btn-full text-sm" onclick="fillDemo('ana@demo.com','Usuario')">👤 Ana Martínez (Usuario)</button>
      <button type="button" class="btn btn-ghost btn-full text-sm" onclick="fillDemo('carlos@demo.com','Nutriologo')">🩺 Dr. Carlos (Nutriólogo)</button>
      <button type="button" class="btn btn-ghost btn-full text-sm" onclick="fillDemo('laura@demo.com','Nutriologo')">🩺 Dra. Laura (Nutriólogo)</button>
    </div>
  </div>
</div>

<script src="~/js/site.js"></script>
<script>
function selectRole(role) {
  document.getElementById('role-usuario').classList.toggle('selected', role === 'Usuario');
  document.getElementById('role-nutriologo').classList.toggle('selected', role === 'Nutriologo');
  document.getElementById('loginTitle').textContent =
    role === 'Usuario' ? 'Iniciar sesión como Usuario' : 'Iniciar sesión como Nutriólogo';
  document.getElementById('email').placeholder =
    role === 'Usuario' ? 'maria@demo.com' : 'carlos@demo.com';
}
function fillDemo(email, role) {
  selectRole(role);
  document.getElementById('email').value = email;
  document.getElementById('password').value = 'demo123';
}
</script>
</body>
</html>
