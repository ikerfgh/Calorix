@using Calorix.Models
@{
    ViewData["Title"] = "Planes Alimenticios";
    var pacientes = (List<Usuario>)ViewBag.Pacientes;
    int pacienteId = ViewBag.PacienteId ?? 0;
    var planes = ViewBag.Planes as List<PlanAlimenticio> ?? new();
    var todosAlimentos = (List<Alimento>)ViewBag.TodosAlimentos;
}

<div class="page-header">
  <div>
    <div class="page-title">Planes Alimenticios</div>
    <div class="page-subtitle">Crea y gestiona planes para tus pacientes</div>
  </div>
  <div style="margin-left:auto">
    <button class="btn btn-primary" onclick="openModal('modal-plan')">+ Nuevo Plan</button>
  </div>
</div>

<div class="page-body">
  <!-- Filtro por paciente -->
  <div class="card mb-6">
    <div class="flex items-center gap-4 flex-wrap">
      <span class="text-sm font-medium">Paciente:</span>
      <a href="/Planes" class="btn btn-sm @(pacienteId==0?"btn-primary":"btn-outline")">Todos</a>
      @foreach (var p in pacientes)
      {
        <a href="/Planes?pacienteId=@p.Id" class="btn btn-sm @(pacienteId==p.Id?"btn-primary":"btn-outline")">
          @p.Nombre
        </a>
      }
    </div>
  </div>

  @if (pacienteId > 0)
  {
    var pac = pacientes.FirstOrDefault(p => p.Id == pacienteId);
    <div class="flex items-center gap-3 mb-4">
      <div class="paciente-avatar" style="width:40px;height:40px">@pac?.Nombre[0]</div>
      <div>
        <div class="font-semibold">@pac?.Nombre</div>
        <div class="text-xs text-muted">@planes.Count plan(es) activo(s)</div>
      </div>
    </div>

    @if (!planes.Any())
    {
      <div class="card" style="text-align:center;padding:3rem">
        <div style="font-size:3rem;margin-bottom:1rem">📋</div>
        <div class="font-semibold">Sin planes para este paciente</div>
        <button class="btn btn-primary mt-4" onclick="openModal('modal-plan')">Crear primer plan</button>
      </div>
    }
    else
    {
      <div class="grid grid-2 gap-4">
        @foreach (var plan in planes)
        {
          <div class="card">
            <div class="flex justify-between items-start mb-3">
              <div>
                <div class="font-semibold text-lg">@plan.Nombre</div>
                <div class="text-xs text-muted">@plan.FechaCreacion.ToString("dd/MM/yyyy")</div>
              </div>
              @if (plan.Activo)
              {
                <span class="badge badge-success">Activo</span>
              }
            </div>
            @foreach (var c in plan.Comidas)
            {
              <div class="flex items-center gap-3 mb-2">
                <span class="momento-badge momento-@c.Momento">@c.Momento</span>
                <span class="text-sm">@c.Descripcion</span>
                @if (c.Calorias > 0)
                {
                  <span class="text-xs text-muted ml-auto">@c.Calorias kcal</span>
                }
              </div>
            }
            @if (plan.Comidas.Any())
            {
              <hr class="divider" />
              <div class="text-sm text-muted">Total: <strong style="color:var(--color-primary)">@plan.Comidas.Sum(c => c.Calorias) kcal</strong></div>
            }
          </div>
        }
      </div>
    }
  }
  else
  {
    <div class="card" style="text-align:center;padding:3rem">
      <div style="font-size:3rem;margin-bottom:1rem">👆</div>
      <div class="font-semibold">Selecciona un paciente</div>
      <div class="text-sm text-muted mt-1">Elige un paciente arriba para ver o crear planes</div>
    </div>
  }
</div>

<!-- Modal Nuevo Plan -->
<div class="modal-overlay" id="modal-plan">
  <div class="modal" style="max-width:600px">
    <div class="modal-header">
      <span class="modal-title">📋 Nuevo Plan Alimenticio</span>
      <button class="modal-close" onclick="closeModal('modal-plan')">✕</button>
    </div>
    <div class="modal-body">
      <div class="form-group">
        <label class="form-label">Nombre del plan *</label>
        <input type="text" id="plan-nombre" class="form-control" placeholder="Ej. Plan Pérdida de Peso" />
      </div>
      <div class="form-group">
        <label class="form-label">Paciente *</label>
        <select id="plan-paciente" class="form-control">
          <option value="">Selecciona un paciente</option>
          @foreach (var p in pacientes)
          {
            <option value="@p.Id" selected="@(p.Id==pacienteId)">@p.Nombre</option>
          }
        </select>
      </div>

      <hr class="divider" />
      <div class="card-title mb-3">Agregar Comidas al Plan</div>

      <div class="grid" style="grid-template-columns:1fr 1fr auto;gap:.75rem;align-items:end">
        <div class="form-group" style="margin-bottom:0">
          <label class="form-label">Momento</label>
          <select id="plan-momento" class="form-control">
            <option value="Desayuno">🌅 Desayuno</option>
            <option value="Comida">☀️ Comida</option>
            <option value="Cena">🌙 Cena</option>
            <option value="Snack">🍎 Snack</option>
          </select>
        </div>
        <div class="form-group" style="margin-bottom:0">
          <label class="form-label">Calorías estimadas</label>
          <input type="number" id="plan-cal" class="form-control" placeholder="500" min="0" />
        </div>
        <button type="button" class="btn btn-secondary" onclick="addComidaPlan()">+</button>
      </div>
      <div class="form-group mt-3">
        <label class="form-label">Descripción de la comida *</label>
        <input type="text" id="plan-desc" class="form-control" placeholder="Ej. Proteína magra con vegetales" />
      </div>

      <div id="plan-comidas-list" class="mt-3">
        <p class="text-xs text-muted">Sin comidas aún.</p>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-outline" onclick="closeModal('modal-plan')">Cancelar</button>
      <button class="btn btn-primary" onclick="submitPlan()">Crear Plan</button>
    </div>
  </div>
</div>
