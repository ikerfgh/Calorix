@using Calorix.Models
@{
    ViewData["Title"] = "Planes Alimenticios";
    var pacientes = (List<Usuario>)ViewBag.Pacientes;
    int pacienteId = ViewBag.PacienteId ?? 0;
    var planes = ViewBag.Planes as List<PlanAlimenticio> ?? new();
    var recetasClinicas = ViewBag.RecetasClinicas as List<Receta> ?? new();
    var todosAlimentos = ViewBag.TodosAlimentos as List<Alimento> ?? new();
}

<div class="page-header">
  <div>
    <div class="page-title">Planes Alimenticios</div>
    <div class="page-subtitle">Crea y gestiona planes y recetas clínicas para tus pacientes</div>
  </div>
  <div style="display:flex;gap:8px">
    <button type="button" class="btn btn-ghost" onclick="openModal('modal-receta-clinica')">+ Receta clínica</button>
    <button type="button" class="btn btn-primary" onclick="openModal('modal-plan')">+ Nuevo Plan</button>
  </div>
</div>

@if (recetasClinicas.Any())
{
  <div class="card mb-4">
    <div class="card-header">
      <div class="card-title">🍽️ Mis Recetas Clínicas (@recetasClinicas.Count)</div>
    </div>
    <div class="grid-auto" style="--min:220px">
      @foreach (var r in recetasClinicas)
      {
        <div style="background:var(--bg3);border-radius:8px;padding:12px">
          <div style="font-weight:700">@r.Nombre</div>
          @if (!string.IsNullOrEmpty(r.Descripcion))
          {
            <div class="text-xs text-muted mt-1">@r.Descripcion</div>
          }
          <div class="text-xs mt-2"><strong style="color:var(--green)">@((int)r.CaloriasTotal) kcal</strong> · P:@((int)r.ProteinasTotal)g · C:@((int)r.CarbosTotal)g · G:@((int)r.GrasasTotal)g</div>
        </div>
      }
    </div>
  </div>
}

<!-- ── FILTRO PACIENTE ── -->
<div class="tabs">
  <a href="/Planes" class="tab @(pacienteId==0?"active":"")">Todos</a>
  @foreach (var p in pacientes)
  {
    <a href="/Planes?pacienteId=@p.Id" class="tab @(pacienteId==p.Id?"active":"")">@p.Nombre</a>
  }
</div>

@if (pacienteId > 0)
{
  var pac = pacientes.FirstOrDefault(p => p.Id == pacienteId);
  <div class="flex items-center gap-3 mb-4">
    <div class="patient-avatar" style="width:40px;height:40px;font-size:16px">@pac?.Nombre[0]</div>
    <div>
      <div style="font-family:var(--font-head);font-weight:700">@pac?.Nombre</div>
      <div class="text-xs text-muted">@planes.Count plan(es) activo(s)</div>
    </div>
  </div>

  @if (!planes.Any())
  {
    <div class="empty">
      <div class="empty-icon">📋</div>
      <div class="empty-title">Sin planes para este paciente</div>
      <button type="button" class="btn btn-primary mt-4" onclick="openModal('modal-plan')">Crear primer plan</button>
    </div>
  }
  else
  {
    <div class="grid-2">
      @foreach (var plan in planes)
      {
        <div class="plan-card" data-plan-id="@plan.Id">
          <div class="plan-card-header">
            <div style="flex:1;min-width:0">
              <div style="font-family:var(--font-head);font-size:15px;font-weight:700">@plan.Nombre</div>
              <div class="text-xs text-muted">@plan.FechaCreacion.ToString("dd/MM/yyyy")</div>
            </div>
            <div class="plan-card-actions">
              @if (plan.Activo) { <span class="badge badge-green">Activo</span> }
              <button type="button" class="plan-action-btn" title="Editar plan" onclick="abrirEditarPlan(@plan.Id)">✏️</button>
              <button type="button" class="plan-action-btn plan-action-del" title="Eliminar plan" onclick='confirmarEliminarPlan(@plan.Id, @Html.Raw(System.Text.Json.JsonSerializer.Serialize(plan.Nombre)))'>🗑️</button>
            </div>
          </div>
          @foreach (var c in plan.Comidas)
          {
            <div class="plan-meal-row">
              <span class="plan-meal-label">@c.Momento</span>
              <span class="plan-meal-desc">@c.Descripcion</span>
              @if (c.Calorias > 0) { <span class="plan-meal-cal">@c.Calorias kcal</span> }
            </div>
          }
          @if (plan.Comidas.Any())
          {
            <div class="text-xs text-muted">Total: <strong style="color:var(--green)">@plan.Comidas.Sum(c => c.Calorias) kcal</strong></div>
          }
        </div>
      }
    </div>
  }
}
else
{
  <div class="empty">
    <div class="empty-icon">👆</div>
    <div class="empty-title">Selecciona un paciente</div>
    <div>Elige un paciente arriba para ver o crear planes</div>
  </div>
}

<!-- ── MODAL NUEVO PLAN ── -->
<div class="overlay" id="modal-plan" onclick="closeModal('modal-plan')">
  <div class="modal modal-wide" onclick="event.stopPropagation()">
    <div class="modal-title">📋 Nuevo Plan Alimenticio</div>

    <div class="form-group">
      <label class="form-label">Nombre del plan *</label>
      <input type="text" id="plan-nombre" class="form-control" placeholder="Ej. Plan Pérdida de Peso semana 1" />
    </div>
    <div class="form-group">
      <label class="form-label">Pacientes * <span class="text-xs text-muted">(selecciona uno o varios)</span></label>
      <div id="plan-pacientes-list" style="background:var(--bg3);border-radius:8px;padding:10px;max-height:160px;overflow-y:auto;display:flex;flex-direction:column;gap:6px">
        @if (!pacientes.Any())
        {
          <div class="text-sm text-muted">No tienes pacientes vinculados aún.</div>
        }
        else
        {
          foreach (var p in pacientes)
          {
            <label style="display:flex;align-items:center;gap:8px;cursor:pointer">
              <input type="checkbox" name="plan-paciente-chk" value="@p.Id" @(p.Id == pacienteId ? "checked" : "") />
              <span>@p.Nombre <span class="text-xs text-muted">@p.Email</span></span>
            </label>
          }
        }
      </div>
    </div>

    <div class="sep"></div>
    <div class="text-sm text-muted mb-3">Agregar comidas al plan:</div>

    <div style="display:grid;grid-template-columns:1fr 1fr 100px auto;gap:10px;align-items:end">
      <div class="form-group" style="margin-bottom:0">
        <label class="form-label">Momento</label>
        <select id="plan-momento" class="form-control">
          <option value="Desayuno">☀️ Desayuno</option>
          <option value="Comida">🌤️ Comida</option>
          <option value="Cena">🌙 Cena</option>
          <option value="Snack">🍎 Snack</option>
        </select>
      </div>
      <div class="form-group" style="margin-bottom:0">
        <label class="form-label">Descripción</label>
        <input type="text" id="plan-desc" class="form-control" placeholder="Proteína magra con vegetales" />
      </div>
      <div class="form-group" style="margin-bottom:0">
        <label class="form-label">kcal</label>
        <input type="number" id="plan-cal" class="form-control" placeholder="500" min="0" />
      </div>
      <button type="button" class="btn btn-ghost" onclick="addComidaPlan()">+</button>
    </div>

    <div id="plan-comidas-list" class="mt-3" style="display:flex;flex-direction:column;gap:6px">
      <div class="text-xs text-muted">Sin comidas aún.</div>
    </div>

    <div style="display:flex;gap:10px;margin-top:18px">
      <button type="button" class="btn btn-ghost" style="flex:1" onclick="closeModal('modal-plan')">Cancelar</button>
      <button type="button" class="btn btn-primary" style="flex:1" onclick="submitPlan()">Crear Plan</button>
    </div>
  </div>
</div>

<!-- ── MODAL CREAR RECETA CLÍNICA ── -->
<div class="overlay" id="modal-receta-clinica" onclick="closeModal('modal-receta-clinica')">
  <div class="modal modal-wide" onclick="event.stopPropagation()">
    <div class="modal-title">🍽️ Crear Receta Clínica</div>
    <div class="text-sm text-muted mb-3">Crea una receta para usarla en planes de tus pacientes (p. ej. necesidades dietéticas específicas).</div>

    <div class="form-group">
      <label class="form-label">Nombre *</label>
      <input type="text" id="rc-nombre" class="form-control" placeholder="Ej. Bowl bajo en sodio" />
    </div>
    <div class="form-group">
      <label class="form-label">Descripción</label>
      <input type="text" id="rc-desc" class="form-control" placeholder="Indicaciones, alergias soportadas, etc." />
    </div>

    <div class="sep"></div>
    <div class="text-sm text-muted mb-3">Agregar ingredientes:</div>

    <div style="display:grid;grid-template-columns:1fr 120px auto;gap:10px;align-items:end">
      <div class="form-group" style="margin-bottom:0">
        <label class="form-label">Alimento</label>
        <select id="rc-alimento" class="form-control">
          @foreach (var a in todosAlimentos)
          {
            <option value="@a.Id" data-nombre="@a.Nombre">@a.Nombre</option>
          }
        </select>
      </div>
      <div class="form-group" style="margin-bottom:0">
        <label class="form-label">Gramos</label>
        <input type="number" id="rc-cantidad" class="form-control" value="100" min="1" max="2000" />
      </div>
      <button type="button" class="btn btn-ghost" onclick="rcAddIngrediente()">+</button>
    </div>

    <div id="rc-ingredientes-list" class="mt-3" style="display:flex;flex-direction:column;gap:6px">
      <div class="text-xs text-muted">Sin ingredientes aún.</div>
    </div>

    <div style="display:flex;gap:10px;margin-top:18px">
      <button type="button" class="btn btn-ghost" style="flex:1" onclick="closeModal('modal-receta-clinica')">Cancelar</button>
      <button type="button" class="btn btn-primary" style="flex:1" onclick="rcSubmit()">Crear receta</button>
    </div>
  </div>
</div>

<!-- ── MODAL EDITAR PLAN ── -->
<div class="overlay" id="modal-editar-plan" onclick="closeModal('modal-editar-plan')">
  <div class="modal modal-wide" onclick="event.stopPropagation()">
    <div class="modal-title">✏️ Editar Plan Alimenticio</div>

    <input type="hidden" id="edit-plan-id" />

    <div class="form-group">
      <label class="form-label">Nombre del plan *</label>
      <input type="text" id="edit-plan-nombre" class="form-control" />
    </div>

    <div class="sep"></div>
    <div class="text-sm text-muted mb-3">Comidas del plan:</div>

    <div style="display:grid;grid-template-columns:1fr 1fr 100px auto;gap:10px;align-items:end">
      <div class="form-group" style="margin-bottom:0">
        <label class="form-label">Momento</label>
        <select id="edit-plan-momento" class="form-control">
          <option value="Desayuno">☀️ Desayuno</option>
          <option value="Comida">🌤️ Comida</option>
          <option value="Cena">🌙 Cena</option>
          <option value="Snack">🍎 Snack</option>
        </select>
      </div>
      <div class="form-group" style="margin-bottom:0">
        <label class="form-label">Descripción</label>
        <input type="text" id="edit-plan-desc" class="form-control" placeholder="Proteína magra con vegetales" />
      </div>
      <div class="form-group" style="margin-bottom:0">
        <label class="form-label">kcal</label>
        <input type="number" id="edit-plan-cal" class="form-control" placeholder="500" min="0" />
      </div>
      <button type="button" class="btn btn-ghost" onclick="addEditComidaPlan()">+</button>
    </div>

    <div id="edit-plan-comidas-list" class="mt-3" style="display:flex;flex-direction:column;gap:6px">
      <div class="text-xs text-muted">Sin comidas aún.</div>
    </div>

    <div style="display:flex;gap:10px;margin-top:18px">
      <button type="button" class="btn btn-ghost" style="flex:1" onclick="closeModal('modal-editar-plan')">Cancelar</button>
      <button type="button" class="btn btn-primary" style="flex:1" onclick="submitEditarPlan()">Guardar Cambios</button>
    </div>
  </div>
</div>

<!-- ── MODAL CONFIRMAR ELIMINACIÓN ── -->
<div class="overlay" id="modal-confirmar-eliminar" onclick="closeModal('modal-confirmar-eliminar')">
  <div class="modal" onclick="event.stopPropagation()">
    <div class="modal-title">🗑️ Eliminar plan</div>
    <p class="text-sm" style="margin-bottom:8px">¿Estás seguro que quieres eliminar este plan?</p>
    <p class="text-sm text-muted" id="del-plan-name" style="margin-bottom:18px;font-style:italic"></p>
    <p class="text-xs text-muted" style="margin-bottom:18px">⚠️ El paciente dejará de ver este plan inmediatamente. Esta acción no se puede deshacer.</p>
    <div style="display:flex;gap:10px">
      <button type="button" class="btn btn-ghost" style="flex:1" onclick="closeModal('modal-confirmar-eliminar')">Cancelar</button>
      <button type="button" class="btn btn-danger" style="flex:1" onclick="ejecutarEliminarPlan()">Sí, eliminar</button>
    </div>
  </div>
</div>

@section Scripts {
<script>
  let _editPlanComidas = [];
  let _planAEliminar = 0;
  let _rcIngredientes = [];

  // ── RECETA CLÍNICA ──
  function rcAddIngrediente() {
    const sel = document.getElementById('rc-alimento');
    const opt = sel.options[sel.selectedIndex];
    const aId = parseInt(sel.value);
    const cant = parseFloat(document.getElementById('rc-cantidad').value) || 0;
    if (!aId || cant <= 0) { notify('Alimento o cantidad inválida', 'error'); return; }
    _rcIngredientes.push({ alimentoId: aId, cantidad: cant, nombre: opt.dataset.nombre });
    rcRender();
  }

  function rcRemove(i) { _rcIngredientes.splice(i, 1); rcRender(); }

  function rcRender() {
    const el = document.getElementById('rc-ingredientes-list');
    if (!el) return;
    if (!_rcIngredientes.length) {
      el.innerHTML = '<div class="text-xs text-muted">Sin ingredientes aún.</div>';
      return;
    }
    el.innerHTML = _rcIngredientes.map((ing, i) => `
      <div class="plan-meal-row">
        <span class="plan-meal-desc">${esc(ing.nombre)}</span>
        <span class="plan-meal-cal">${ing.cantidad} g</span>
        <button class="chip-clear" onclick="rcRemove(${i})">✕</button>
      </div>`).join('');
  }

  async function rcSubmit() {
    const nombre = document.getElementById('rc-nombre').value.trim();
    const desc = document.getElementById('rc-desc').value.trim();
    if (!nombre) { notify('Escribe el nombre de la receta', 'error'); return; }
    if (!_rcIngredientes.length) { notify('Agrega al menos un ingrediente', 'error'); return; }

    const fd = new FormData();
    fd.append('nombre', nombre);
    fd.append('descripcion', desc);
    fd.append('ingredientesJson', JSON.stringify(_rcIngredientes.map(i => ({
      AlimentoId: i.alimentoId, Cantidad: i.cantidad
    }))));

    try {
      const r = await fetch('/Planes/CrearRecetaClinica', { method: 'POST', body: fd });
      const data = await r.json();
      if (data.ok) {
        notify(`✓ Receta clínica creada (${data.calorias} kcal)`);
        setTimeout(() => location.reload(), 500);
      } else {
        notify(data.mensaje || 'No se pudo crear la receta', 'error');
      }
    } catch (e) {
      notify('Error de conexión', 'error');
    }
  }

  async function abrirEditarPlan(planId) {
    try {
      const r = await fetch('/Planes/Detalle?planId=' + planId);
      const d = await r.json();
      if (!d.ok) { notify('No se pudo cargar el plan', 'error'); return; }
      document.getElementById('edit-plan-id').value = d.id;
      document.getElementById('edit-plan-nombre').value = d.nombre || '';
      _editPlanComidas = (d.comidas || []).map(c => ({
        momento: c.momento, descripcion: c.descripcion, calorias: c.calorias
      }));
      renderEditPlanComidas();
      openModal('modal-editar-plan');
    } catch (e) {
      notify('Error de conexión', 'error');
    }
  }

  function addEditComidaPlan() {
    const momento = document.getElementById('edit-plan-momento').value;
    const desc = document.getElementById('edit-plan-desc').value.trim();
    const cal = parseFloat(document.getElementById('edit-plan-cal').value) || 0;
    if (!desc) { notify('Escribe la descripción de la comida', 'error'); return; }
    _editPlanComidas.push({ momento, descripcion: desc, calorias: cal });
    document.getElementById('edit-plan-desc').value = '';
    document.getElementById('edit-plan-cal').value = '';
    renderEditPlanComidas();
  }

  function removeEditPlanComida(i) {
    _editPlanComidas.splice(i, 1);
    renderEditPlanComidas();
  }

  function renderEditPlanComidas() {
    const el = document.getElementById('edit-plan-comidas-list');
    if (!el) return;
    if (!_editPlanComidas.length) {
      el.innerHTML = '<div class="text-xs text-muted">Sin comidas aún.</div>';
      return;
    }
    el.innerHTML = _editPlanComidas.map((c, i) => `
      <div class="plan-meal-row">
        <span class="plan-meal-label">${esc(c.momento)}</span>
        <span class="plan-meal-desc">${esc(c.descripcion)}</span>
        ${c.calorias ? `<span class="plan-meal-cal">${c.calorias} kcal</span>` : ''}
        <button class="chip-clear" onclick="removeEditPlanComida(${i})">✕</button>
      </div>`).join('');
  }

  async function submitEditarPlan() {
    const planId = parseInt(document.getElementById('edit-plan-id').value);
    const nombre = document.getElementById('edit-plan-nombre').value.trim();
    if (!planId) { notify('Plan inválido', 'error'); return; }
    if (!nombre) { notify('El plan necesita un nombre', 'error'); return; }
    if (!_editPlanComidas.length) { notify('Agrega al menos una comida', 'error'); return; }

    const formData = new FormData();
    formData.append('planId', planId);
    formData.append('nombre', nombre);
    formData.append('comidasJson', JSON.stringify(_editPlanComidas.map(c => ({
      Momento: c.momento, Descripcion: c.descripcion, Calorias: c.calorias, AlimentoIds: []
    }))));

    try {
      const r = await fetch('/Planes/Editar', { method: 'POST', body: formData });
      const data = await r.json();
      if (data.ok) {
        notify('✓ Plan actualizado');
        setTimeout(() => location.reload(), 400);
      } else {
        notify(data.mensaje || 'Error al guardar', 'error');
      }
    } catch (e) {
      notify('Error de conexión', 'error');
    }
  }

  function confirmarEliminarPlan(planId, nombre) {
    _planAEliminar = planId;
    document.getElementById('del-plan-name').textContent = '"' + nombre + '"';
    openModal('modal-confirmar-eliminar');
  }

  async function ejecutarEliminarPlan() {
    if (!_planAEliminar) return;
    const formData = new FormData();
    formData.append('planId', _planAEliminar);
    try {
      const r = await fetch('/Planes/Eliminar', { method: 'POST', body: formData });
      const data = await r.json();
      if (data.ok) {
        notify('✓ Plan eliminado');
        closeModal('modal-confirmar-eliminar');
        // Quitar la card visualmente y luego recargar
        const card = document.querySelector(`.plan-card[data-plan-id="${_planAEliminar}"]`);
        if (card) card.style.opacity = '0.4';
        setTimeout(() => location.reload(), 400);
      } else {
        notify(data.mensaje || 'No se pudo eliminar', 'error');
      }
    } catch (e) {
      notify('Error de conexión', 'error');
    }
    _planAEliminar = 0;
  }
</script>
}
