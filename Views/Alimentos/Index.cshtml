@using Calorix.Models
@{
    ViewData["Title"] = "Alimentos y Recetas";
    var alimentos = (List<Alimento>)ViewBag.Alimentos;
    var recetas = (List<Receta>)ViewBag.Recetas;
    var todosAlimentos = (List<Alimento>)ViewBag.TodosAlimentos;
    var q = (string)ViewBag.Q ?? "";

    var categorias = todosAlimentos.Select(a => a.Categoria).Distinct().OrderBy(c => c).ToList();
}

<div class="page-header">
  <div>
    <div class="page-title">Biblioteca de Alimentos</div>
    <div class="page-subtitle">Explora alimentos y crea tus recetas personalizadas</div>
  </div>
  <button type="button" class="btn btn-primary" onclick="openModal('modal-receta')">+ Crear Receta</button>
</div>

@if (TempData["Msg"] != null)
{
  <div class="alert alert-success">@TempData["Msg"]</div>
}
@if (TempData["Err"] != null)
{
  <div class="alert alert-error">@TempData["Err"]</div>
}

<!-- ── BUSCADOR ── -->
<form method="get" action="/Alimentos" class="mb-4">
  <div class="search-wrap" style="max-width:480px">
    <i class="s-icon">🔍</i>
    <input type="text" name="q" value="@q" class="form-control" placeholder="Buscar alimento o categoría…" />
  </div>
</form>

<!-- ── CATEGORIAS ── -->
<div class="tabs">
  <a href="/Alimentos" class="tab @(string.IsNullOrEmpty(q)?"active":"")">Todos</a>
  @foreach (var cat in categorias)
  {
    <a href="/Alimentos?q=@cat" class="tab @(q==cat?"active":"")">@cat</a>
  }
</div>

<!-- ── ALIMENTOS ── -->
<div class="grid-auto mb-6">
  @foreach (var a in alimentos)
  {
    <div class="food-card">
      <div class="food-icon">🥗</div>
      <div style="flex:1">
        <div class="food-name">@a.Nombre</div>
        <div class="food-cat">@a.Categoria</div>
        <div class="text-xs text-muted" style="margin-top:2px">P:@a.Proteinas g · C:@a.Carbohidratos g · G:@a.Grasas g</div>
      </div>
      <div style="text-align:right">
        <div class="food-cal">@a.Calorias</div>
        <div class="food-cal-unit">kcal/100g</div>
      </div>
    </div>
  }
  @if (!alimentos.Any())
  {
    <div class="empty" style="grid-column:1/-1">
      <div class="empty-icon">🔍</div>
      <div class="empty-title">Sin resultados</div>
      <div>Intenta con otra búsqueda</div>
    </div>
  }
</div>

<div class="sep"></div>

<!-- ── MIS RECETAS ── -->
<div class="section-hd">
  <div class="section-title">Mis Recetas (@recetas.Count)</div>
</div>

@if (!recetas.Any())
{
  <div class="empty">
    <div class="empty-icon">🍳</div>
    <div class="empty-title">Sin recetas aún</div>
    <div>Crea tu primera receta combinando alimentos</div>
    <button type="button" class="btn btn-primary mt-4" onclick="openModal('modal-receta')">Crear primera receta</button>
  </div>
}
else
{
  <div class="grid-auto">
    @foreach (var r in recetas)
    {
      <div class="food-card">
        <div class="food-icon">🍽️</div>
        <div style="flex:1">
          <div class="food-name">@r.Nombre</div>
          <div class="food-cat">@r.Descripcion</div>
          <div class="text-xs text-muted" style="margin-top:2px">P:@r.ProteinasTotal g · C:@r.CarbosTotal g · G:@r.GrasasTotal g</div>
        </div>
        <div style="text-align:right">
          <div class="food-cal">@r.CaloriasTotal</div>
          <div class="food-cal-unit">kcal/porción</div>
        </div>
      </div>
    }
  </div>
}

<!-- ── MODAL CREAR RECETA ── -->
<div class="overlay" id="modal-receta" onclick="closeModal('modal-receta')">
  <div class="modal" onclick="event.stopPropagation()">
    <div class="modal-title">🍳 Crear Receta Personalizada</div>

    <form id="receta-form" method="post" action="/Alimentos/CrearReceta">
      <input type="hidden" name="ingredientesJson" id="receta-ingredientes-json" />

      <div class="form-group">
        <label class="form-label">Nombre *</label>
        <input type="text" id="receta-nombre" name="nombre" class="form-control" placeholder="Ej. Bowl proteico de pollo" required />
      </div>
      <div class="form-group">
        <label class="form-label">Descripción</label>
        <input type="text" id="receta-desc" name="descripcion" class="form-control" placeholder="Breve descripción…" />
      </div>

      <div class="form-group">
        <label class="form-label">Agregar ingrediente</label>
        <div style="display:flex;gap:8px;align-items:center">
          <select id="ing-alimento" class="form-control" style="flex:2">
            @foreach (var a in todosAlimentos)
            {
              <option value="@a.Id" data-nombre="@a.Nombre">@a.Nombre (@a.Calorias kcal/100g)</option>
            }
          </select>
          <input type="number" id="ing-cantidad" class="form-control" style="width:80px" placeholder="g" min="1" value="100" />
          <button type="button" class="btn btn-ghost" onclick="addIngFromForm()">+</button>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Ingredientes</label>
        <div id="ingredientes-list">
          <div class="text-xs text-muted">Sin ingredientes aún.</div>
        </div>
      </div>
    </form>

    <div style="display:flex;gap:10px;margin-top:8px">
      <button type="button" class="btn btn-ghost" style="flex:1" onclick="closeModal('modal-receta')">Cancelar</button>
      <button type="button" class="btn btn-primary" style="flex:1" onclick="submitReceta()">Guardar Receta</button>
    </div>
  </div>
</div>

@section Scripts {
<script>
function addIngFromForm() {
  const sel = document.getElementById('ing-alimento');
  const id = sel.value;
  const nombre = sel.options[sel.selectedIndex].dataset.nombre;
  const cant = parseFloat(document.getElementById('ing-cantidad').value) || 100;
  addIngrediente(id, nombre, cant);
}
</script>
}
