@using Calorix.Models
@{
    ViewData["Title"] = "Mi Perfil";
    var u = (Usuario?)ViewBag.Usuario;
}

<div class="page-header">
  <div>
    <div class="page-title">Mi Perfil</div>
    <div class="page-subtitle">Tu información personal y metas nutricionales</div>
  </div>
</div>

<div class="page-body">
  @if (u == null)
  {
    <div class="alert alert-error">No se encontró el perfil.</div>
  }
  else
  {
    <div class="grid" style="grid-template-columns:320px 1fr;gap:var(--space-6)">
      <!-- Profile card -->
      <div class="card" style="height:fit-content">
        <div style="text-align:center;padding-bottom:var(--space-4);border-bottom:1px solid var(--color-border);margin-bottom:var(--space-4)">
          <div style="width:72px;height:72px;background:var(--color-primary);border-radius:var(--radius-full);display:flex;align-items:center;justify-content:center;font-size:2rem;font-weight:700;color:#fff;margin:0 auto var(--space-3)">
            @u.Nombre[0]
          </div>
          <div class="font-semibold text-xl">@u.Nombre</div>
          <div class="text-sm text-muted mt-1">@u.Email</div>
          <div class="badge badge-primary mt-2">Usuario</div>
        </div>
        <div class="text-sm">
          <div class="flex justify-between mb-3">
            <span class="text-muted">Meta calórica</span>
            <strong style="color:var(--color-primary)">@((int)u.MetaCalorica) kcal</strong>
          </div>
          <div class="flex justify-between mb-3">
            <span class="text-muted">Edad</span>
            <span>@u.Edad años</span>
          </div>
          <div class="flex justify-between mb-3">
            <span class="text-muted">Peso</span>
            <span>@u.Peso kg</span>
          </div>
          <div class="flex justify-between mb-3">
            <span class="text-muted">Altura</span>
            <span>@u.Altura cm</span>
          </div>
          <div class="flex justify-between mb-3">
            <span class="text-muted">Género</span>
            <span>@(u.Genero == "M" ? "Masculino" : "Femenino")</span>
          </div>
          <div class="flex justify-between">
            <span class="text-muted">Actividad</span>
            <span>@u.NivelActividad</span>
          </div>
        </div>
      </div>

      <!-- Edit form -->
      <div class="card">
        <div class="card-title mb-1">Actualizar Información</div>
        <div class="card-desc mb-6">Los cambios recalcularán automáticamente tu meta calórica</div>

        <form method="post" action="/Perfil/Actualizar">
          <div class="grid grid-2 gap-4">
            <div class="form-group">
              <label class="form-label">Peso (kg)</label>
              <input type="number" name="peso" step="0.1" class="form-control"
                     value="@u.Peso" min="30" max="300" required />
            </div>
            <div class="form-group">
              <label class="form-label">Altura (cm)</label>
              <input type="number" name="altura" step="0.1" class="form-control"
                     value="@u.Altura" min="100" max="250" required />
            </div>
            <div class="form-group">
              <label class="form-label">Edad</label>
              <input type="number" name="edad" class="form-control"
                     value="@u.Edad" min="10" max="120" required />
            </div>
            <div class="form-group">
              <label class="form-label">Nivel de Actividad</label>
              <select name="actividad" class="form-control">
                <option value="Sedentario" selected="@(u.NivelActividad=="Sedentario")">Sedentario</option>
                <option value="Ligero" selected="@(u.NivelActividad=="Ligero")">Ligero (1-2 días/semana)</option>
                <option value="Moderado" selected="@(u.NivelActividad=="Moderado")">Moderado (3-5 días/semana)</option>
                <option value="Activo" selected="@(u.NivelActividad=="Activo")">Activo (6-7 días/semana)</option>
                <option value="MuyActivo" selected="@(u.NivelActividad=="MuyActivo")">Muy Activo (2x al día)</option>
              </select>
            </div>
          </div>

          <div class="alert alert-info mt-2" style="font-size:var(--font-size-xs)">
            ℹ️ La meta calórica se recalcula con la fórmula <strong>Mifflin-St Jeor</strong> al guardar.
            Puedes cambiar la fórmula en la vista de Seguimiento.
          </div>

          <div class="flex gap-3 mt-4">
            <button type="submit" class="btn btn-primary">Guardar cambios</button>
            <a href="/Seguimiento" class="btn btn-outline">Cancelar</a>
          </div>
        </form>
      </div>
    </div>
  }
</div>
